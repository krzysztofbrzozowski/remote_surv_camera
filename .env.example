# Django
# REQUIRED: Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=your-domain.com,your-ip-address
# Set to "true" to enable HTTPS redirect (requires SSL termination)
# SECURE_SSL_REDIRECT=true

# Admin URL segment (optional; set a private value in your local .env)
# DJANGO_ADMIN_PATH=control-panel

# Camera — REQUIRED: use a strong random token shared between RPi and server
CAMERA_TOKEN=change-me-to-a-secure-token

# Server
SERVER_PORT=8000

# Recordings
RECORDING_CHUNK_SIZE_MB=100

# Admin user — create manually after first deploy:
#   docker compose exec server python manage.py createsuperuser

# Login rate limiting
# LOGIN_RATELIMIT_MAX_ATTEMPTS=5
# LOGIN_RATELIMIT_WINDOW_SECONDS=300

# Network interface for stats monitoring (auto-detected if empty)
# Set to physical NIC name (e.g. eth0, enp1s0) to avoid Docker bridge overcounting
# NETWORK_INTERFACE=

# TURN relay — required for viewers behind Symmetric NAT / CGNAT (e.g. mobile carriers).
# Without TURN, direct UDP may fail and viewers see a black screen.
# TURN_SERVER=turn:your-server-ip:3478?transport=udp
# TURN_USERNAME=camrelay
# TURN_PASSWORD=change-me-to-a-secure-password
